NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. From Supabase dashboard: Project Settings > API > service_role secret key.
SUPABASE_SERVICE_ROLE_KEY=
# Used to build invite redirect links (e.g. https://sunny-sphere.vercel.app)
NEXT_PUBLIC_SITE_URL=
# Drive API key (restricted to the Drive API), for the hourly Housekeeping
# metadata sync. Only works on files shared "Anyone with the link can view".
GOOGLE_DRIVE_API_KEY=
# Shared secret checked against the cron request's Authorization header, so
# only Vercel's scheduler (not the public) can trigger the sync endpoint.
CRON_SECRET=
# OAuth 2.0 Web application client (Google Cloud Console > APIs & Services >
# Credentials) with the Calendar API enabled and NEXT_PUBLIC_SITE_URL +
# "/api/google/callback" added as an authorized redirect URI. Powers the
# Task Management "Connect Google Calendar" button — each person connects
# their own account to sync their task due dates onto their own calendar.
# Left unset, the connect button is simply hidden.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
